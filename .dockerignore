# Keep the build context small and never bake datasets/videos into the image.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.git/
*.md
tests/

# Local DB artifacts (the container uses a mounted volume)
*.db
*.sqlite
*.sqlite3

# Model weights (downloaded at runtime)
*.pt

# Dataset / video files — never ship these
videos/
data/videos/
data/clips/
data/outputs/
data/raw/
data/official/
*.mp4
*.avi
*.mov
*.mkv

# Regenerable pipeline output (not needed in the API image)
data/generated_events.jsonl
